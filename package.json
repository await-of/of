{
  "author": "Anton Trofymenko",
  "bugs": {
    "url": "https://github.com/await-of/of/issues"
  },
  "contributors": [
    {
      "email": "r37r0m0d3l@protonmail.com",
      "name": "Anton Trofymenko"
    }
  ],
  "description": "Promise wrapper with some sugar",
  "devDependencies": {
    "prettier": "3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.1-rc"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=8.12.0"
  },
  "engineStrict": true,
  "exports": {
    ".": {
      "import": "./dist/of.js",
      "browser": {
        "import": "./dist/of.js"
      },
      "node": {
        "import": "./dist/of.js"
      },
      "default": "./dist/of.js"
    }
  },
  "files": [
    "dist/of.js",
    "dist/of.js.map",
    "dist/of.d.ts"
  ],
  "homepage": "https://of.js.org",
  "keywords": [
    "async await",
    "async",
    "await",
    "error swallowing",
    "errors handling",
    "promise",
    "try-catch",
    "wrapper"
  ],
  "license": "MIT",
  "main": "./dist/of.js",
  "module": "./dist/of.js",
  "name": "@await-of/of",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/await-of/of.git"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --minify --treeshake --entry.of src/index.ts",
    "dev": "tsup src/index.ts --format esm --watch --dts",
    "docs:serve": "docsify serve docs",
    "prepublishOnly": "npm run build",
    "test": "node --test ./test/index.test.js"
  },
  "type": "module",
  "types": "./dist/of.d.ts",
  "version": "3.0.0"
}
